generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  TOP
  BOTTOM
  DRESS
  OUTERWEAR
  SHOES
  ACCESSORY
  BAG
}

enum Season {
  SPRING
  SUMMER
  AUTUMN
  WINTER
  ALL
}

enum Occasion {
  CASUAL
  WORK
  FORMAL
  PARTY
  SPORT
  DATE
  TRAVEL
}

enum AiProvider {
  ENGINE
  OPENAI
  GEMINI
}

/// The household's admin account (email/password). Owns profiles, devices and AI settings.
model User {
  id            String        @id @default(cuid())
  name          String?
  email         String        @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  aiProvider    AiProvider    @default(ENGINE)
  openaiKeyEnc  String?
  openaiModel   String?
  geminiKeyEnc  String?
  geminiModel   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  accounts      Account[]
  sessions      Session[]
  profiles      Profile[]
  devices       Device[]
  pairingCodes  PairingCode[]
}

/// A person in the household. Each has their own wardrobe and unlocks with a PIN.
model Profile {
  id               String           @id @default(cuid())
  ownerId          String
  name             String
  avatarColor      String           @default("#B4645A")
  pinHash          String
  isAdmin          Boolean          @default(false)
  stylePreferences String[]         @default([])
  failedAttempts   Int              @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime         @default(now())
  owner            User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items            ClothingItem[]
  outfits          Outfit[]
  favorites        FavoriteOutfit[]

  @@index([ownerId])
}

model Device {
  id         String    @id @default(cuid())
  ownerId    String
  name       String
  tokenHash  String    @unique
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model PairingCode {
  id        String    @id @default(cuid())
  ownerId   String
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model ClothingItem {
  id        String       @id @default(cuid())
  profileId String
  title     String
  category  Category
  color     String
  colorHex  String?
  season    Season       @default(ALL)
  occasions Occasion[]   @default([])
  tags      Tag[]
  imageUrl  String
  brand     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  profile   Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  outfits   OutfitItem[]

  @@index([profileId, category])
}

model Outfit {
  id        String           @id @default(cuid())
  profileId String
  name      String
  occasion  Occasion?
  score     Int?
  notes     String?
  aiReason  String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  profile   Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  items     OutfitItem[]
  favorites FavoriteOutfit[]

  @@index([profileId])
}

model OutfitItem {
  outfitId String
  itemId   String
  position Int          @default(0)
  outfit   Outfit       @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  item     ClothingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([outfitId, itemId])
}

model FavoriteOutfit {
  profileId String
  outfitId  String
  createdAt DateTime @default(now())
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  outfit    Outfit   @relation(fields: [outfitId], references: [id], onDelete: Cascade)

  @@id([profileId, outfitId])
}

model Tag {
  id    String         @id @default(cuid())
  name  String         @unique
  items ClothingItem[]
}

// NextAuth models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
