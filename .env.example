# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/veyra?schema=public"

# Household admin key — pairs devices, resets forgotten PINs, unlocks household settings.
# Make it long and random: openssl rand -base64 24
ADMIN_KEY="replace-me"

# Behind a reverse proxy (Nginx, Caddy, Vercel…)? Set to 1 so rate limits use the real client IP.
TRUST_PROXY="0"

# Optional: encrypts AI keys saved in Settings (defaults to ADMIN_KEY — set this so you can rotate ADMIN_KEY later)
ENCRYPTION_KEY=""

# Optional fallbacks for the AI Stylist. Keys are normally added in Settings → AI Stylist.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Optional: Cloudinary image uploads (falls back to ./public/uploads in development if unset)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional: self-host the on-device background-removal model files (default: IMG.LY CDN)
NEXT_PUBLIC_BG_REMOVAL_PATH=""
