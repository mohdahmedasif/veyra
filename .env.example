# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/veyra?schema=public"

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-me"

# Optional: encrypts AI keys saved in Settings (defaults to NEXTAUTH_SECRET). openssl rand -base64 32
ENCRYPTION_KEY=""

# Optional fallbacks for the AI Stylist. Keys are normally added in Settings → AI Stylist.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Optional: Cloudinary image uploads (falls back to ./public/uploads in development if unset)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
